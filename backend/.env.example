PORT=5000
NODE_ENV=development
BUILD_TARGET=development

# Server Configuration
BACKEND_PORT=5000
FRONTEND_PORT=3000

# Domain Configuration
CORS_ORIGIN=http://localhost:3000
DEPLOY_DOMAIN=localhost
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL="file:./prisma/dev.db"

# JWT — REQUIRED. The server refuses to boot if unset or empty.
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE=7d

# Google OAuth (optional — Google login is disabled when blank)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Session — REQUIRED. The server refuses to boot if unset or empty.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Puzzle Generation — used by the deterministic daily-puzzle seed.
PUZZLE_SECRET=

# Auto-solve Configuration
AUTO_SOLVE_COOLDOWN_HOURS=6

# Rate-limit bypass (development only). Requires NODE_ENV=development too.
# Leave unset in production. If you set this in production, rate limits are
# completely disabled — don't.
RATE_LIMIT_BYPASS=false

# Per-puzzle reveal-letter limits (UserProgress.lastRevealAt + dailyRevealCount).
REVEAL_LETTER_COOLDOWN_SECONDS=60
REVEAL_LETTER_DAILY_CAP=5
